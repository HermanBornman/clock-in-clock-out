{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/weekly-hr-report",
      "schedule": "5 6 * * 1"
    },
    {
      "path": "/api/cron/weekly-hr-report-retry",
      "schedule": "20 6 * * 1"
    },
    {
      "path": "/api/cron/daily-attendance-alert",
      "schedule": "0 6 * * 1-5"
    }
  ]
}
